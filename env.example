// README
// This is only a .env example
// Do not change this file!
// Use cp or mv (like this: cp env.example .env), then edit .env with your Keys.
// IMPORTANT: Don't forget to add to update your .gitignore with .env (to avoid public share your key!)

DATABASE_URL=
NEXTAUTH_SECRET=type-anything-or-generate-a-guid-online-and-use-that
NEXTAUTH_URL=http://localhost:3020/

NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_PRESET_NAME=

GITHUB_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tavily Search API Keys (supports up to 20 keys for rotation)
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
TAVILY_API_KEY_3=
TAVILY_API_KEY_4=
TAVILY_API_KEY_5=
TAVILY_API_KEY_6=
TAVILY_API_KEY_7=
TAVILY_API_KEY_8=
TAVILY_API_KEY_9=
TAVILY_API_KEY_10=
TAVILY_API_KEY_11=
TAVILY_API_KEY_12=
TAVILY_API_KEY_13=
TAVILY_API_KEY_14=
TAVILY_API_KEY_15=
TAVILY_API_KEY_16=
TAVILY_API_KEY_17=
TAVILY_API_KEY_18=
TAVILY_API_KEY_19=
TAVILY_API_KEY_20=

# Google Custom Search API Keys (supports up to 10 keys for rotation)
GO_API_KEY_1=
GO_API_KEY_2=
GOOGLE_SEARCH_ENGINE_ID=

# Oxylabs Proxy (required for Hotel URL Finder)
OXYLABS_USER=
OXYLABS_PASS=

# Optional: CAPTCHA solving
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: set to 1 to enable verbose Tavily request logging (off by default).
# Never logs API keys; intended for local debugging only.
TAVILY_DEBUG=