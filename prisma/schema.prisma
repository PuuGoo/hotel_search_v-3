// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  hashedPassword  String?
  role            String? @default("user") // admin, user
  // Per-feature allow-list. Empty/missing = no restriction (full access), which
  // keeps every pre-existing account working. A non-empty list restricts the
  // user to exactly those feature keys (see src/app/libs/features.ts). Admins
  // bypass this entirely.
  permissions     String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversationIds String[] @db.ObjectId
  conversations Conversation[] @relation(fields: [conversationIds], references: [id])
  
  seenMessageIds String[] @db.ObjectId
  seenMessages Message[] @relation("Seen", fields: [seenMessageIds], references: [id])

  accounts Account[]
  messages Message[]
  bookmarks Bookmark[]
  searchHistory SearchHistory[]
  priceAlerts PriceAlert[]
  searches Search[]
  auditLogs AuditLog[] @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.String
  access_token       String?  @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Conversation {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  createdAt       DateTime @default(now())
  lastMessageAt DateTime @default(now())
  name String?
  isGroup Boolean?
  
  messagesIds String[] @db.ObjectId
  messages Message[]

  userIds String[] @db.ObjectId
  users User[] @relation(fields: [userIds], references: [id])

  // getConversations filters by membership (userIds) and orders by
  // lastMessageAt desc; index the sort key so the conversation list stays fast.
  @@index([lastMessageAt])
}

model Message {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  body String?
  image String?
  createdAt DateTime @default(now())

  seenIds String[] @db.ObjectId
  seen User[] @relation("Seen", fields: [seenIds], references: [id])

  conversationId String @db.ObjectId
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId String @db.ObjectId
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // getMessages filters by conversationId and orders by createdAt; this compound
  // index serves both without a full collection scan as message volume grows.
  @@index([conversationId, createdAt])
}

// Hotel Search Models

model Hotel {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  address String?
  city String?
  country String?
  url String? @unique
  imageUrl String?
  rating Float?
  priceRange String?
  description String?
  source String? // tavily, google, ddg, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks Bookmark[]
  searchResults SearchResult[]
}

model Search {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  query String
  engine String // tavily, google, ddg, xng, case12
  resultCount Int @default(0)
  duration Int? // milliseconds
  createdAt DateTime @default(now())

  userId String? @db.ObjectId
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  results SearchResult[]

  // The search-history GET and dashboard both filter by userId and order by
  // createdAt desc; this compound index avoids a collection scan + in-memory sort.
  @@index([userId, createdAt])
}

model SearchResult {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String?
  url String?
  snippet String?
  position Int?
  score Float?
  createdAt DateTime @default(now())

  searchId String @db.ObjectId
  search Search @relation(fields: [searchId], references: [id], onDelete: Cascade)

  hotelId String? @db.ObjectId
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  // Results are always looked up by their parent search (relation include).
  @@index([searchId])
}

model Bookmark {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  title String?
  url String?
  notes String?
  folder String? @default("default")
  tags String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.ObjectId
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  hotelId String? @db.ObjectId
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  // The bookmarks GET filters by userId (optionally folder/tag) and orders by
  // createdAt desc; this compound index covers the common case.
  @@index([userId, createdAt])
}

model SearchHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  query String
  engine String?
  resultCount Int?
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-user history is written on every search and read back by user.
  @@index([userId, createdAt])
}

model PriceAlert {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  hotelName String
  targetPrice Float
  currentPrice Float?
  isActive Boolean @default(true)
  lastChecked DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.ObjectId
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Price alerts are queried per user.
  @@index([userId])
}

// Admin accountability trail. Every privileged mutation (role change, user
// deletion) writes one immutable row here. The actor relation uses SetNull so
// deleting an admin never cascades away the history of what they did; the
// human-readable actorEmail/targetEmail are denormalized so a log entry stays
// meaningful even after the referenced user is gone.
model AuditLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  action String // e.g. user.role.update, user.delete
  actorId String? @db.ObjectId
  actorEmail String?
  targetType String? // e.g. user
  targetId String?
  targetEmail String?
  metadata Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  // The audit view lists most-recent first.
  @@index([createdAt])
}

// Password reset tokens. We store only a SHA-256 HASH of the token, never the
// raw value, so a database leak cannot be used to reset accounts. The raw token
// is delivered to the user via the reset link and verified by re-hashing. Each
// row is single-use (deleted on successful reset) and time-limited (expiresAt).
model PasswordResetToken {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Look-ups are by tokenHash (unique) and we purge by userId when issuing a
  // fresh token, so index userId for the delete-many.
  @@index([userId])
}